{
  "title": "KodaClaw Agent 总览",
  "uid": "kodaclaw-agent",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "tags": ["kodaclaw", "agent"],
  "panels": [

    { "type": "row", "title": "Agent 运行", "gridPos": {"h":1,"w":24,"x":0,"y":0}, "collapsed": false, "id": 1 },

    {
      "id": 2, "title": "运行总数（每分钟）", "type": "timeseries",
      "gridPos": {"h":7,"w":8,"x":0,"y":1},
      "datasource": {"uid": "prometheus"},
      "targets": [{
        "expr": "rate(kodaclaw_kode_agent_runs_started_total[1m])",
        "legendFormat": "启动 / {{session_type}}",
        "refId": "A"
      },{
        "expr": "rate(kodaclaw_kode_agent_runs_completed_total[1m])",
        "legendFormat": "完成 / {{session_type}}",
        "refId": "B"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": {"lineWidth":2} } }
    },

    {
      "id": 3, "title": "Run 平均耗时（ms）", "type": "timeseries",
      "gridPos": {"h":7,"w":8,"x":8,"y":1},
      "datasource": {"uid": "prometheus"},
      "targets": [{
        "expr": "rate(kodaclaw_kode_agent_run_duration_milliseconds_sum[2m]) / rate(kodaclaw_kode_agent_run_duration_milliseconds_count[2m])",
        "legendFormat": "avg run duration / {{session_type}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },

    {
      "id": 4, "title": "Step 完成（每分钟）", "type": "stat",
      "gridPos": {"h":7,"w":8,"x":16,"y":1},
      "datasource": {"uid": "prometheus"},
      "targets": [{
        "expr": "sum(rate(kodaclaw_kode_agent_steps_completed_total[1m]))",
        "legendFormat": "steps/s",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps", "color": {"mode":"thresholds"}, "thresholds": {"steps": [{"color":"green","value":null}]} } },
      "options": { "reduceOptions": {"calcs": ["lastNotNull"]}, "orientation":"auto", "textMode":"auto", "colorMode":"background" }
    },

    { "type": "row", "title": "Token 用量 & 成本", "gridPos": {"h":1,"w":24,"x":0,"y":8}, "collapsed": false, "id": 10 },

    {
      "id": 11, "title": "Input Tokens（每分钟）", "type": "timeseries",
      "gridPos": {"h":8,"w":12,"x":0,"y":9},
      "datasource": {"uid": "prometheus"},
      "targets": [{
        "expr": "sum by (session_type) (rate(kodaclaw_kode_agent_tokens_input_tokens_total[1m]))",
        "legendFormat": "input / {{session_type}}",
        "refId": "A"
      },{
        "expr": "sum by (agent_role) (rate(kodaclaw_kode_agent_tokens_input_tokens_total[1m]))",
        "legendFormat": "input / {{agent_role}}",
        "refId": "B"
      }],
      "fieldConfig": { "defaults": { "unit": "none", "custom": {"lineWidth":2} } }
    },

    {
      "id": 12, "title": "Output Tokens（每分钟）", "type": "timeseries",
      "gridPos": {"h":8,"w":12,"x":12,"y":9},
      "datasource": {"uid": "prometheus"},
      "targets": [{
        "expr": "sum by (session_type) (rate(kodaclaw_kode_agent_tokens_output_tokens_total[1m]))",
        "legendFormat": "output / {{session_type}}",
        "refId": "A"
      },{
        "expr": "sum by (agent_role) (rate(kodaclaw_kode_agent_tokens_output_tokens_total[1m]))",
        "legendFormat": "output / {{agent_role}}",
        "refId": "B"
      }],
      "fieldConfig": { "defaults": { "unit": "none", "custom": {"lineWidth":2} } }
    },

    {
      "id": 13, "title": "Token 分布（session_type）", "type": "piechart",
      "gridPos": {"h":8,"w":8,"x":0,"y":17},
      "datasource": {"uid": "prometheus"},
      "targets": [{
        "expr": "sum by (session_type) (increase(kodaclaw_kode_agent_tokens_input_tokens_total[1h]))",
        "legendFormat": "{{session_type}}",
        "refId": "A"
      }],
      "options": { "pieType":"pie", "displayLabels":["name","percent"] }
    },

    {
      "id": 14, "title": "Sub-Agent vs Primary Token 占比", "type": "piechart",
      "gridPos": {"h":8,"w":8,"x":8,"y":17},
      "datasource": {"uid": "prometheus"},
      "targets": [{
        "expr": "sum by (agent_role) (increase(kodaclaw_kode_agent_tokens_input_tokens_total[1h]))",
        "legendFormat": "{{agent_role}}",
        "refId": "A"
      }],
      "options": { "pieType":"donut", "displayLabels":["name","percent"] }
    },

    {
      "id": 15, "title": "Context 压缩次数", "type": "stat",
      "gridPos": {"h":8,"w":8,"x":16,"y":17},
      "datasource": {"uid": "prometheus"},
      "targets": [{
        "expr": "sum(increase(kodaclaw_kode_agent_context_compressions_total[1h]))",
        "legendFormat": "compressions",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "short", "color": {"mode":"thresholds"}, "thresholds": {"steps": [{"color":"blue","value":null},{"color":"orange","value":5},{"color":"red","value":20}]} } },
      "options": { "reduceOptions": {"calcs":["lastNotNull"]}, "colorMode":"background" }
    },

    { "type": "row", "title": "模型请求 & TTFT", "gridPos": {"h":1,"w":24,"x":0,"y":25}, "collapsed": false, "id": 20 },

    {
      "id": 21, "title": "TTFT P50/P95/P99（ms）", "type": "timeseries",
      "gridPos": {"h":8,"w":12,"x":0,"y":26},
      "datasource": {"uid": "prometheus"},
      "targets": [{
        "expr": "histogram_quantile(0.5, sum by (le, model) (rate(kodaclaw_kode_agent_model_time_to_first_token_milliseconds_bucket[2m])))",
        "legendFormat": "p50 {{model}}",
        "refId": "A"
      },{
        "expr": "histogram_quantile(0.95, sum by (le, model) (rate(kodaclaw_kode_agent_model_time_to_first_token_milliseconds_bucket[2m])))",
        "legendFormat": "p95 {{model}}",
        "refId": "B"
      },{
        "expr": "histogram_quantile(0.99, sum by (le, model) (rate(kodaclaw_kode_agent_model_time_to_first_token_milliseconds_bucket[2m])))",
        "legendFormat": "p99 {{model}}",
        "refId": "C"
      }],
      "fieldConfig": { "defaults": { "unit": "ms", "custom": {"lineWidth":2} } }
    },

    {
      "id": 22, "title": "模型请求耗时 P95（ms）", "type": "timeseries",
      "gridPos": {"h":8,"w":12,"x":12,"y":26},
      "datasource": {"uid": "prometheus"},
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le, model) (rate(kodaclaw_kode_agent_model_request_duration_milliseconds_bucket[2m])))",
        "legendFormat": "p95 {{model}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },

    {
      "id": 23, "title": "模型错误（按 error_type）", "type": "timeseries",
      "gridPos": {"h":8,"w":12,"x":0,"y":34},
      "datasource": {"uid": "prometheus"},
      "targets": [{
        "expr": "sum by (error_type) (rate(kodaclaw_kode_agent_model_errors_total[1m]))",
        "legendFormat": "{{error_type}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps", "color": {"mode":"palette-classic"} } }
    },

    {
      "id": 24, "title": "模型请求数（每分钟）", "type": "stat",
      "gridPos": {"h":8,"w":12,"x":12,"y":34},
      "datasource": {"uid": "prometheus"},
      "targets": [{
        "expr": "sum(rate(kodaclaw_kode_agent_model_requests_total[1m]))",
        "legendFormat": "req/s",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "options": { "reduceOptions": {"calcs":["lastNotNull"]}, "colorMode":"background" }
    },

    { "type": "row", "title": "工具执行", "gridPos": {"h":1,"w":24,"x":0,"y":42}, "collapsed": false, "id": 30 },

    {
      "id": 31, "title": "工具调用（按分类）", "type": "timeseries",
      "gridPos": {"h":8,"w":12,"x":0,"y":43},
      "datasource": {"uid": "prometheus"},
      "targets": [{
        "expr": "sum by (tool_category) (rate(kodaclaw_kode_agent_tool_executions_total[1m]))",
        "legendFormat": "{{tool_category}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": {"lineWidth":2} } }
    },

    {
      "id": 32, "title": "工具耗时 P95（ms，按分类）", "type": "timeseries",
      "gridPos": {"h":8,"w":12,"x":12,"y":43},
      "datasource": {"uid": "prometheus"},
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le, tool_category) (rate(kodaclaw_kode_agent_tool_duration_milliseconds_bucket[2m])))",
        "legendFormat": "p95 {{tool_category}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },

    {
      "id": 33, "title": "工具错误率", "type": "timeseries",
      "gridPos": {"h":8,"w":12,"x":0,"y":51},
      "datasource": {"uid": "prometheus"},
      "targets": [{
        "expr": "sum by (tool_category) (rate(kodaclaw_kode_agent_tool_errors_total[1m])) / sum by (tool_category) (rate(kodaclaw_kode_agent_tool_executions_total[1m]))",
        "legendFormat": "error rate / {{tool_category}}",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min":0, "max":1 } }
    },

    {
      "id": 34, "title": "Top 工具（调用量 1h）", "type": "bargauge",
      "gridPos": {"h":8,"w":12,"x":12,"y":51},
      "datasource": {"uid": "prometheus"},
      "targets": [{
        "expr": "topk(10, sum by (tool_name) (increase(kodaclaw_kode_agent_tool_executions_total[1h])))",
        "legendFormat": "{{tool_name}}",
        "refId": "A"
      }],
      "options": { "orientation":"horizontal", "reduceOptions":{"calcs":["lastNotNull"]}, "displayMode":"gradient" },
      "fieldConfig": { "defaults": { "unit": "short" } }
    }

  ]
}
