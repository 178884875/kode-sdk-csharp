# Docker deployment environment variables
# Copy to docker-compose.env (or inline in docker-compose.yml) and fill in your values.
#
# API keys can also be configured without env vars:
#   After starting the container, open http://localhost:5076/setup
#   to complete onboarding through the browser Setup Wizard.

# ── Model API Keys (at least one required) ─────────────────────────────────────
KODACLAW_ANTHROPIC_API_KEY=
KODACLAW_OPENAI_API_KEY=

# ── Gateway ───────────────────────────────────────────────────────────────────
KODACLAW_GATEWAY_URL=http://0.0.0.0:5076
KODACLAW_WORKSPACE_ROOT=/workspace

# ── Optional: authentication token (leave empty to disable) ───────────────────
KODACLAW_GATEWAY_TOKEN=

# ── Optional: OpenTelemetry ───────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
