# KodaClaw local development defaults
# Gateway 启动时会先读取当前目录的 .env，再读取 .env.local；
# shell 中已存在的真实环境变量优先级更高。
# 如需配置 Runtime:OpenAIBaseUrl / Gateway:StartupRepairEnabled 等 JSON 键，
# 优先放到当前目录 appsettings.json / appsettings.Development.json，
# 或使用 .NET 环境变量映射（例如 Runtime__OpenAIBaseUrl）。
KODACLAW_WORKSPACE_ROOT=
KODACLAW_GATEWAY_URL=http://127.0.0.1:5076
# Preferred in Iteration 7+: e.g. keychain:gateway:api-token or memory:gateway:test-token
KODACLAW_GATEWAY_TOKEN_SECRET_REF=
KODACLAW_GATEWAY_TOKEN=replace-me
# Optional extra browser origins beyond loopback and packaged desktop Origin:null
KODACLAW_CORS_ALLOWED_ORIGINS=
KODACLAW_UPDATE_MANIFEST_PATH=
KODACLAW_UPDATE_RELEASE_CHANNEL=Stable
KODACLAW_GATEWAY_CURRENT_VERSION=
KODACLAW_DESKTOP_RELEASE_CHANNEL=
KODACLAW_DEFAULT_MODEL=
ANTHROPIC_API_KEY_SECRET_REF=
ANTHROPIC_API_KEY=
OPENAI_API_KEY_SECRET_REF=
OPENAI_API_KEY=
# Optional .NET configuration-style overrides
Runtime__OpenAIBaseUrl=
Runtime__AnthropicBaseUrl=
Gateway__StartupRepairEnabled=true
