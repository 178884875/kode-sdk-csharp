{
  "manifest_version": 3,
  "name": "KodaClaw Browser Bridge",
  "version": "0.1.0",
  "description": "KodaClaw 浏览器自动化桥接扩展，连接浏览器与 KodaClaw Gateway",

  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "debugger"
  ],

  "host_permissions": [
    "http://localhost:*/*",
    "https://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://127.0.0.1:*/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "KodaClaw Browser Bridge"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
